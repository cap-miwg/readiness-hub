# Readiness Hub v2 configuration. Copy to .env (quickstart.sh does this for you).

# --- Required ---
DB_PASSWORD=change-me
SESSION_SECRET=change-me-generate-64-hex-chars
# dev = local user picker (no Google needed). google = Google Workspace OIDC.
AUTH_MODE=dev
# Public URL of this deployment, used for OAuth redirects and links.
BASE_URL=http://localhost:8080

# --- Google Workspace sign-in (AUTH_MODE=google) ---
# Create an OAuth 2.0 Web client in Google Cloud Console; authorized redirect
# URI is $BASE_URL/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Workspace domains whose members may sign in.
ALLOWED_DOMAINS=miwg.cap.gov
# Comma-separated emails that get the admin role (ingest, settings, logs).
ADMIN_EMAILS=

# --- Optional: scheduled CAPWATCH fetch from eServices ---
# Leave blank to ingest by ZIP upload only. The account must hold CAPWATCH
# download permission (annual security course + attestation).
CAPWATCH_ORGID=
ESERVICES_USERNAME=
ESERVICES_PASSWORD=
# Default 04:00 daily; NHQ blocks downloads 00:00-02:30 Central.
CAPWATCH_FETCH_CRON=0 4 * * *

# --- Tuning ---
APP_NAME=Readiness Hub
APP_PORT=8080
TZ=America/New_York
